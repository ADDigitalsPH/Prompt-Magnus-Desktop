{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Magnus Desktop",
  "version": "0.2.0",
  "identifier": "com.promptmagnus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Prompt Magnus Desktop",
        "label": "main",
        "width": 980,
        "height": 680,
        "minWidth": 980,
        "minHeight": 560,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
